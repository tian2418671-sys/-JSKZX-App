{
  "name": "sillytavern-card-manager",
  "version": "1.10.16",
  "description": "SillyTavern 角色卡高级解析中心 - 移动版（Vue 3 + Vant + Capacitor）",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:web": "node -e \"require('fs').rmSync('web',{recursive:true,force:true})\" && vite build",
    "sync:android": "npm run build:web && npx cap sync android && node scripts/post-cap-sync.mjs",
    "build:android": "npm run sync:android && cd android && gradlew.bat assembleDebug",
    "test": "node --test"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "echarts": "^6.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.41"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "dompurify": "3.4.13",
    "showdown": "^2.1.0",
    "vant": "^4.10.0",
    "vue-router": "^5.2.0"
  }
}
